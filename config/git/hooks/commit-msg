#!/bin/sh
# ==============================================================================
# Global commit-msg dispatcher — ~/.config/git/hooks/commit-msg
#
# core.hooksPath redirects ALL hooks to this directory, which would silently disable
# repository-local ones; this chains .git/hooks/commit-msg.local (executable) instead.
# ==============================================================================

HOOK_NAME="$(basename "$0")"
LOCAL_HOOK="$(git rev-parse --git-dir)/hooks/${HOOK_NAME}.local"

if [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$@"
fi

exit 0
