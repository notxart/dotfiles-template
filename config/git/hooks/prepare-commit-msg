#!/bin/sh
# ==============================================================================
# Global prepare-commit-msg hook — ~/.config/git/hooks/prepare-commit-msg
#
# Injects the AI draft (.git/AI_COMMIT_MSG) into a plain `git commit` buffer, then chains
# the .local hook; core.editor carries the other wrapping rules (./check.sh compares).
# ==============================================================================
set -e

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"
SHA1="$3"

GIT_DIR="$(git rev-parse --git-dir)"
AI_MSG_FILE="${GIT_DIR}/AI_COMMIT_MSG"

# Inject the AI draft only for plain `git commit` (empty source).
if [ -z "$COMMIT_SOURCE" ] && [ -f "$AI_MSG_FILE" ] && [ -s "$AI_MSG_FILE" ]; then
    TEMP_FILE="$(mktemp)"

    # Rules are INLINED, not sourced: this hook is reached through the ~/.config/git
    # symlink, so locating a sibling file is unreliable — a fallback once dropped the
    # continuation indent of every wrapped bullet. Same program as core.editor's.
    awk '
    function wrap(prefix, cont, text,    out, line, word, sep, i, n, w) {
        n = split(text, w, /[ \t]+/)
        out = ""
        line = prefix
        for (i = 1; i <= n; i++) {
            word = w[i]
            if (word == "") continue
            sep = (line == prefix) ? "" : " "
            if (length(line) + length(sep) + length(word) > 72 && line != prefix) {
                out = out line "\n"
                line = cont word
            } else {
                line = line sep word
            }
        }
        return out line
    }
    NR == 1 { sub(/[ \t]+$/, ""); print; next }
    {
        line = $0
        sub(/[ \t]+$/, "", line)
        if (line == "") { print ""; next }
        if (line ~ /^(Refs|Closes|Fixes|Co-authored-by|Signed-off-by|Reviewed-by|Acked-by|Tested-by|Reported-by):/) {
            print line
            next
        }
        # An INDENTED line is a continuation of the item above, which is what this
        # formatter produces for a broken bullet. Keeping the indent is what makes a
        # second pass a no-op — the real commit path runs these rules twice (this hook,
        # then core.editor) — and the two copies must stay identical.
        if (line ~ /^[ \t]/) { print wrap("  ", "  ", line); next }
        if (line ~ /^- /) { print wrap("- ", "  ", substr(line, 3)); next }
        print wrap("", "", line)
    }
    ' "$AI_MSG_FILE" > "$TEMP_FILE"

    printf '\n' >> "$TEMP_FILE"
    cat "$COMMIT_MSG_FILE" >> "$TEMP_FILE"

    mv "$TEMP_FILE" "$COMMIT_MSG_FILE"
fi

# Chain the repository-local hook (if any) for backwards compatibility.
# exec runs the hook as this process (direct argv execve - no shell string
# interpretation, same trust boundary as a plain call) so the hook's exit
# status reaches git unchanged. The AI draft is kept until post-commit.
LOCAL_HOOK="${GIT_DIR}/hooks/prepare-commit-msg.local"
if [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$COMMIT_MSG_FILE" "$COMMIT_SOURCE" "$SHA1"
fi

exit 0
