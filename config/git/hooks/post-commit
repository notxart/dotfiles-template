#!/bin/sh
# ==============================================================================
# Global post-commit dispatcher — ~/.config/git/hooks/post-commit
#
# Chains .git/hooks/post-commit.local, and removes .git/AI_COMMIT_MSG after the first
# successful commit; a failed one keeps the draft so the human can retry unchanged.
# ==============================================================================

HOOK_NAME="$(basename "$0")"
GIT_DIR="$(git rev-parse --git-dir)"
LOCAL_HOOK="${GIT_DIR}/hooks/${HOOK_NAME}.local"

# Successful commit -> the draft buffer is stale.
AI_MSG_FILE="${GIT_DIR}/AI_COMMIT_MSG"
[ -f "$AI_MSG_FILE" ] && rm -f "$AI_MSG_FILE"

if [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$@"
fi

exit 0
