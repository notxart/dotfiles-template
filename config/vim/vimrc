" =============================================
" Minimal Vim config: ~/.config/vim/vimrc, which Vim >= 9.0 loads natively when
" ~/.vimrc does not exist. It keeps commit messages at the 72-column convention
" while they are written; the formatting rules belong to config/git/wrap-msg.sh.
" =============================================

" Wrap at 72 while typing: a typing aid. The canonical shape comes from
" config/git/wrap-msg.sh (see the save-time pass below).
autocmd FileType gitcommit setlocal textwidth=72

" Visually mark the 73rd column (the wrap limit + 1) in commit messages
autocmd FileType gitcommit setlocal colorcolumn=73

" Save-time pass, with the same formatter as the rest of the toolchain: core.editor only
" sees text that existed when the editor opened, and wrap-msg.sh is idempotent, so this
" is safe to repeat. Only the message is filtered — git's comment block and the verbose
" diff below the '>8' scissors line are left as written. A rejected subject is reported
" on screen and never empties the buffer, because the formatter prints the message
" whatever its verdict.
function! s:FormatCommitMessage() abort
    let l:script = expand('$DSH_DOTFILES_DIR')
    if empty(l:script)
        let l:script = expand('~/dotfiles')
    endif
    let l:script = l:script . '/config/git/wrap-msg.sh'
    if !executable(l:script)
        return
    endif

    " The message ends before git's comment block (and the verbose diff).
    let l:first_comment = search('^#', 'nw')
    let l:last = l:first_comment > 0 ? l:first_comment - 1 : line('$')
    if l:last < 1
        return
    endif

    " keepjumps keeps the cursor still; the range filter replaces only the
    " message lines. shellescape protects a repository path containing spaces.
    silent keepjumps execute '1,' . l:last . '!' . shellescape(l:script)
endfunction

autocmd BufWritePre COMMIT_EDITMSG call s:FormatCommitMessage()
